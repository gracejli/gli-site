# Are.na microblog channel (server-side only; never expose the token to the browser)
# Channel slug only, e.g. gli-microblog (not the full /username/slug URL)
ARENA_CHANNEL_SLUG=gli-microblog

# Required once the channel is private. Create at https://www.are.na/developers/personal-access-tokens
ARENA_API_KEY=

# Flickr API key (server-side only; used by /finterest)
FLICKR_API_KEY=

# Resend (server-side only; used by /posty postcard email delivery)
# Create at https://resend.com/api-keys — without these, /posty falls back to device share / mailto
# In development, emails send immediately. In production, Resend schedules them 7–14 days out.
# Put real values in .env.local (not here).
# Optional absolute site origin for “sent with posty” email link (defaults to https://gracejli.com)
# NEXT_PUBLIC_SITE_URL=https://gracejli.com

RESEND_API_KEY=
POSTCARD_FROM_EMAIL=
